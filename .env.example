# Normally you do not edit this by hand: ./scripts/setup.sh creates .env with random secrets.
# Never commit .env.

# --- Public URLs (what the BROWSER uses) ---
# Local: leave as is. Production: your HTTPS hostnames, and set SOC_COOKIE_SECURE=true, SOC_ENVIRONMENT=production.
SOC_PUBLIC_URL=http://localhost:8080
KC_PUBLIC_URL=http://localhost:8081
SOC_COOKIE_SECURE=false
SOC_ENVIRONMENT=development

# --- Secrets (generated by setup.sh) ---
POSTGRES_PASSWORD=
KC_DB_PASSWORD=
REDIS_PASSWORD=
KC_ADMIN_USER=kcadmin
KC_ADMIN_PASSWORD=
KC_CLIENT_SECRET=
KC_ADMIN_CLIENT_SECRET=
# The one super admin: the only account that can add users and admins. Set by setup.sh.
KC_SUPERADMIN_EMAIL=
KC_SUPERADMIN_PASSWORD=
SOC_SECRET_BACKEND=local
SOC_SECRETS_KEY=
SOC_AUDIT_HMAC_KEY=
SOC_BOOTSTRAP_TOKEN=
SOC_METRICS_TOKEN=

# --- Connector egress allow-list (SSRF protection): only these hosts/networks can be linked as tools ---
SOC_EGRESS_ALLOWED_SUFFIXES=[".corp.local"]
SOC_EGRESS_ALLOWED_CIDRS=["10.0.0.0/8"]
# For Vault instead of the local secret store: SOC_SECRET_BACKEND=vault, SOC_VAULT_ADDR, SOC_VAULT_TOKEN, SOC_VAULT_MOUNT
