# Normally you do not edit this by hand: ./scripts/setup.sh creates .env with random secrets.
# Never commit .env.

# --- Public URLs (what the BROWSER uses) ---
# Local: leave as is. Production: your HTTPS hostnames, and set SOC_COOKIE_SECURE=true, SOC_ENVIRONMENT=production.
SOC_PUBLIC_URL=http://localhost:8080
KC_PUBLIC_URL=http://localhost:8081
SOC_COOKIE_SECURE=false
SOC_ENVIRONMENT=development

# --- Single sign-on ---
# Default: the bundled Keycloak (profile below). To use an external OIDC provider instead, remove the
# profile line and set SOC_OIDC_ISSUER / SOC_OIDC_CLIENT_ID / SOC_OIDC_CLIENT_SECRET / SOC_OIDC_ROLE_CLAIM,
# with SOC_OIDC_INTERNAL_ISSUER= and SOC_KC_ADMIN_URL= left empty (users/roles are then managed in the IdP).
COMPOSE_PROFILES=keycloak

# --- Secrets (generated by setup.sh) ---
POSTGRES_PASSWORD=
KC_DB_PASSWORD=
REDIS_PASSWORD=
KC_ADMIN_USER=kcadmin
KC_ADMIN_PASSWORD=
KC_CLIENT_SECRET=
KC_ADMIN_CLIENT_SECRET=
# The one super admin: the only account that can add users and admins. Set by setup.sh.
KC_SUPERADMIN_EMAIL=
KC_SUPERADMIN_PASSWORD=

# --- Outbound mail for Keycloak (password reset, "Verify Email" required action) ---
# Point this at your mail server (e.g. Mailu's submission port). Leave blank to skip for now;
# "Verify Email" will then never actually send mail even if you add it as a required action.
SOC_SMTP_HOST=
SOC_SMTP_PORT=587
SOC_SMTP_FROM=soc@200m.local
SOC_SMTP_USER=
SOC_SMTP_PASSWORD=
# Set to true once SOC_SMTP_* above is working, to make every newly provisioned user verify
# their email (in addition to the existing UPDATE_PASSWORD / CONFIGURE_TOTP) before first login.
SOC_OIDC_REQUIRE_EMAIL_VERIFICATION=false

SOC_SECRET_BACKEND=local
SOC_SECRETS_KEY=
SOC_AUDIT_HMAC_KEY=
SOC_BOOTSTRAP_TOKEN=
SOC_METRICS_TOKEN=

# --- Connector egress allow-list (SSRF protection): only these hosts/networks can be linked as tools ---
SOC_EGRESS_ALLOWED_SUFFIXES=[".corp.local"]
SOC_EGRESS_ALLOWED_CIDRS=["10.0.0.0/8"]
# For Vault instead of the local secret store: SOC_SECRET_BACKEND=vault, SOC_VAULT_ADDR, SOC_VAULT_TOKEN, SOC_VAULT_MOUNT
